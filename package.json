{
  "name": "excel-template-converter",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node run-apps.mjs dev",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace backend",
    "audit:assets": "npm run audit:assets --workspace backend",
    "start": "node run-apps.mjs start"
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  }
}
